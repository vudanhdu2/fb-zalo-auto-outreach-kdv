# ==============================================================================
# CẤU HÌNH HỆ THỐNG TỰ ĐỘNG NHẮN TIN & TUYỂN KIỂM DUYỆT VIÊN (FB + ZALO)
# Cách dùng: Sao chép file này thành `.env` và điền thông tin thật của bạn.
# ==============================================================================

# 1. THÔNG TIN QUẢN TRỊ VIÊN CHÍNH (Hiển thị trong tin nhắn & đối chiếu danh tính)
ADMIN_FULL_NAME="Nguyễn Văn A"
ADMIN_SHORT_NAME="A"
ADMIN_ZALO_PHONE="0912345678"
ADMIN_ZALO_PHONE_DOT="0912.34.5678"
MAIN_FB_ACTOR_UID="100000000000001"
OWN_ADMIN_FB_UIDS="100000000000001,100000000000002"

# 2. CẤU HÌNH AI LLM (OpenAI-compatible endpoint: OpenAI, Gemini Proxy, OpenRouter, v.v.)
AI_BASE_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY="sk-replace-with-your-own-api-key"
AI_MODEL="gpt-4o-mini"
AI_FALLBACK_MODELS="gpt-4o-mini,gpt-4o"

# 3. CẤU HÌNH KÊNH ZALO (zca-js)
# Chế độ chạy Zalo Bridge:
#   - "local" : Chạy Node.js zca-js trực tiếp trên cùng máy tính này (Khuyên dùng, không cần thuê VPS)
#   - "ssh"   : Chạy Node.js zca-js trên máy chủ Linux VPS từ xa qua SSH
ZALO_BRIDGE_MODE="local"
ZALO_ACCOUNT_ID="acc_default"
ZALO_SENDER_ID="100000000000000000"

# (Chỉ cần điền nếu ZALO_BRIDGE_MODE="ssh")
VPS_HOST="203.0.113.10"
VPS_PORT="22"
VPS_USER="root"
VPS_PASS="your-ssh-password-here"
REMOTE_ZALO_BOT_DIR="/root/zalo_bot"

# 4. CẤU HÌNH CỔNG CHROME CDP (Playwright kết nối vào trình duyệt Chrome đang mở)
#   - Cổng 9232: Nick Facebook Admin chính (nhắn tin Messenger, cấp quyền KDV, chụp ảnh bằng chứng)
#   - Cổng 9234 & 9235: Nick Facebook phụ (Scout đi quét thành viên tích cực, tìm SĐT, kiểm tra huy hiệu)
CDP_MAIN_PORT="9232"
CDP_SCOUT1_PORT="9234"
CDP_SCOUT2_PORT="9235"

# 5. CHẾ ĐỘ AN TOÀN & NHỊP ĐỘ (PACER)
# Khung giờ nghỉ đêm (00h00 - 06h00 sáng không gửi tin nhắn làm phiền)
QUIET_HOURS_START="0"
QUIET_HOURS_END="6"
# Tạm dừng gửi lời mời người mới (ON = chỉ trả lời khách cũ tồn đọng; OFF = vừa trả lời vừa gửi mời mới)
PAUSE_NEW_OUTREACH="OFF"
